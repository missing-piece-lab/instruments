# source this (or export the same names) before `judges.py read …`. Keys are read from the env and never printed.
export JUDGES_FIRST_KIND=anthropic
export JUDGES_FIRST_BASE_URL=https://api.anthropic.com
export JUDGES_FIRST_MODEL=claude-sonnet-4-5
export JUDGES_FIRST_API_KEY=sk-ant-…

# the second judge: any /chat/completions-compatible door (another lab directly, or a router in front of several)
export JUDGES_SECOND_KIND=openai
export JUDGES_SECOND_BASE_URL=https://api.openai.com/v1
export JUDGES_SECOND_MODEL=gpt-5
export JUDGES_SECOND_API_KEY=sk-…
# leave JUDGES_SECOND_MODEL empty for one judge only (agreement "single")
